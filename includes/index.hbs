<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{{siteTitle}}</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" type="image/x-icon" href="favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="{{siteTitle}}" href="{{feedHref}}" />
    <link href="index.css?v1.14.4" rel="stylesheet" />
    <style>
      /* meuFeed — Gruvbox Light layout overrides (inline to avoid theme injection/cache issues) */
      :root {
        color-scheme: light;
        --base00: #fbf1c7;
        --base01: #ebdbb2;
        --base02: #d5c4a1;
        --base03: #bdae93;
        --base04: #665c54;
        --base05: #504945;
        --base06: #3c3836;
        --base07: #282828;
        --base08: #9d0006;
        --base09: #af3a03;
        --base0A: #b57614;
        --base0B: #79740e;
        --base0C: #427b58;
        --base0D: #076678;
        --base0E: #8f3f71;
        --base0F: #d65d0e;
        --body-color: var(--base04);
        --body-bg: var(--base01);
        --body-padding: 28px clamp(14px, 3vw, 40px);
        --body-stack-gap: 28px;
        --card-bg: var(--base00);
        --card-border-color: var(--base02);
        --card-padding: 18px;
        --card-radius: 8px;
        --card-shadow: none;
        --daily-heading-color: var(--base03);
        --daily-heading-hover-color: var(--base04);
        --article-title-color: var(--base0E);
        --article-title-expanded-color: var(--base0E);
        --article-summary-color: var(--base05);
        --article-summary-hover-color: var(--base07);
        --source-name-color: var(--base09);
        --source-name-hover-color: var(--base07);
        --source-link-color: var(--base04);
        --source-link-hover-color: var(--base07);
        --footer-color: var(--base03);
        --footer-link-text: var(--base04);
        --footer-link-hover-color: var(--base07);
      }
      html { background: #ebdbb2 !important; color-scheme: light !important; }
      body {
        background: #ebdbb2 !important;
        color: #665c54 !important;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
        line-height: 1.45 !important;
        padding: 28px clamp(14px, 3vw, 40px) !important;
        gap: 28px !important;
      }
      .daily-heading { font-size: clamp(2.2rem, 3vw, 3.6rem) !important; margin: 0 0 8px !important; }
      .daily-heading-toggle { color: #bdae93 !important; text-transform: lowercase !important; padding: 0 16px !important; gap: 14px !important; }
      .daily-heading-toggle:hover { color: #665c54 !important; }
      .daily-heading-toggle__date { font-size: 1.7rem !important; }
      .sources.card {
        background: #d5c4a1 !important;
        border: 1px solid #d5c4a1 !important;
        border-radius: 8px !important;
        overflow: hidden !important;
      }
      .card__section {
        background: #fbf1c7 !important;
        padding: 16px !important;
      }
      .source-heading { margin-bottom: 8px !important; }
      .source-heading__name { color: #af3a03 !important; }
      .source-heading__name:hover { color: #282828 !important; }
      .source-heading__link { color: #665c54 !important; text-decoration: none !important; }
      .source-heading__link:hover { color: #282828 !important; text-decoration: underline !important; }
      .article-expander { padding: 4px 0 !important; }
      .article-expander__title { color: #8f3f71 !important; font-weight: 600 !important; }
      .article-expander[open] .article-expander__title { color: #8f3f71 !important; }
      .article-summary-link { color: #504945 !important; text-decoration: none !important; }
      .article-summary-link:hover { color: #282828 !important; }
      .article-summary-box-inner { border-left-color: #bdae93 !important; }
      .article-reading-time { color: #665c54 !important; }
      .article-image { border: 1px solid #bdae93 !important; border-radius: 6px !important; }
      footer { color: #bdae93 !important; }
      .footer-link { color: #665c54 !important; }
      @media (max-width: 640px) {
        body { padding: 16px 10px !important; gap: 20px !important; }
        .card__section { padding: 12px !important; }
      }
    </style>
    <!-- %before-head-end.html% -->
  </head>
  <body>
    <!-- %after-body-begin.html% -->
    {{#each dates}}
      <section class="daily-content js-toggle-accordions-scope">
        <h2 class="daily-heading">
          <button class="daily-heading-toggle" data-action="toggle-accordions" title="Click to toggle the day, Ctrl + click to toggle all.">
            <time class="daily-heading-toggle__weekday js-offset-weekday" data-offset-date={{isoOffsetPublishDate}} datetime="{{isoUtcPublishTime}}">{{isoOffsetPublishDate}}</time>
            <time class="daily-heading-toggle__date js-offset-date" data-offset-date={{isoOffsetPublishDate}} datetime="{{isoUtcPublishTime}}"></time>
          </button>
        </h2>
        <ul class="sources card">
          {{#each sources}}
            <li class="card__section">
              <section class="js-toggle-accordions-scope">
                <h3 class="source-heading">
                  <button class="source-heading__name" data-action="toggle-accordions" title="Click to toggle the source, Ctrl + click to toggle all.">{{title}}</button>
                  <a class="source-heading__link" href="{{siteUrl}}">Open</a>
                </h3>
                <section class="articles-per-source">
                  {{#each articles}}
                    <article>
                      <details class="article-expander" data-action="toggle-native-accordion" data-accordion-key="{{id}}" open>
                        <summary class="article-expander__title">{{title}}</summary>
                        <a class="article-summary-link article-summary-box-outer" href="{{link}}">
                          <div class="article-summary-box-inner media-object">
                            {{#if imageUrl}}
                              <img src="{{imageUrl}}" loading="lazy" class="media-object__media article-image" />
                            {{/if}}
                            <span class="media-object__text">
                              <span>{{description}}</span>
                              {{#if readingTimeInMin}}
                                &ensp;<span class="article-reading-time">(&hairsp;{{readingTimeInMin}} min&hairsp;)</span>
                              {{/if}}
                            </span>
                          </div>
                        </a>
                      </details>
                    </article>
                  {{/each}}
                </section>
              </section>
            </li>
          {{/each}}
        </ul>
      </section>
    {{/each}}
    <footer>
      {{#if githubRunUrl}}
      <a class="footer-link" href="{{githubRunUrl}}"><time id="build-timestamp" datetime="{{siteBuildTimestamp}}">{{siteBuildTimestamp}}</time></a>
      {{else}}
      <time id="build-timestamp" datetime="{{siteBuildTimestamp}}">{{siteBuildTimestamp}}</time>
      {{/if}}
      <a class="footer-link" href="{{projectUrl}}">osmosfeed {{cliVersion}}</a>
    </footer>
    <script src="index.js?v1.14.4"></script>
    <!-- %before-body-end.html% -->
  </body>
</html>
